        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryVariant">@color/accent_blue_light</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">@color/bg_dark_navy</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/bg_dark_navy</item>
        <item name="android:navigationBarColor">@color/bg_dark_navy</item>
    </style>
</resources>
