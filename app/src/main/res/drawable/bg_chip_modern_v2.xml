<?xml version="1.0" encoding="utf-8"?>
<!-- Modern chip/pill design -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_dark">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_round" />
            <solid android:color="@color/surface_variant_dark" />
            <stroke
                android:width="1dp"
                android:color="@color/outline_variant_dark" />
        </shape>
    </item>
</ripple>
