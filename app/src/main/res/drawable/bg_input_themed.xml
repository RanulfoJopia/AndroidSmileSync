<?xml version="1.0" encoding="utf-8"?>
<!-- Theme-aware input field background -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/colorInputBackground" />
    <stroke
        android:width="1dp"
        android:color="?attr/colorInputBorder" />
    <corners android:radius="12dp" />
</shape>
