<?xml version="1.0" encoding="utf-8"?>
<!-- Modern input field with subtle elevation -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused State -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_sm" />
            <solid android:color="@color/surface_dark" />
            <stroke
                android:width="2dp"
                android:color="@color/primary" />
        </shape>
    </item>
    
    <!-- Error State -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_sm" />
            <solid android:color="@color/surface_variant_dark" />
            <stroke
                android:width="1dp"
                android:color="@color/outline_variant_dark" />
        </shape>
    </item>
    
    <!-- Default State -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_sm" />
            <solid android:color="@color/surface_dark" />
            <stroke
                android:width="1dp"
                android:color="@color/outline_dark" />
        </shape>
    </item>
</selector>
