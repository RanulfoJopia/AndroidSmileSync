<?xml version="1.0" encoding="utf-8"?>
<!-- Modern elevated card with subtle shadow and rounded corners -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow Layer -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_md" />
            <solid android:color="@color/shadow_dark" />
        </shape>
    </item>
    
    <!-- Card Surface -->
    <item
        android:bottom="2dp"
        android:left="0dp"
        android:right="2dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_md" />
            <solid android:color="@color/surface_dark" />
            <stroke
                android:width="1dp"
                android:color="@color/outline_variant_dark" />
        </shape>
    </item>
</layer-list>
