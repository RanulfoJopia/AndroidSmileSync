<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="40dp"
        android:paddingBottom="80dp">

        <!-- Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3D Model Viewer"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#1A2B4A"
                android:fontFamily="sans-serif-black"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select a patient to view their 3D dental model"
                android:textSize="13sp"
                android:textColor="#5A6B7D" />
        </LinearLayout>

        <!-- Filters Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginBottom="8dp">

            <!-- Date From Filter -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Date From"
                    android:textSize="12sp"
                    android:textColor="#5A6B7D"
                    android:layout_marginBottom="4dp" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_date_from"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tv_date_from"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="mm/dd/yyyy"
                        android:textSize="12sp"
                        android:textColor="#5A6B7D"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Date To Filter -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Date To"
                    android:textSize="12sp"
                    android:textColor="#5A6B7D"
                    android:layout_marginBottom="4dp" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_date_to"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tv_date_to"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="mm/dd/yyyy"
                        android:textSize="12sp"
                        android:textColor="#5A6B7D"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progress_3d_patients"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <!-- Patient List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_3d_patients"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:clipToPadding="false"
            android:scrollbars="none" />

        <!-- Empty State -->
        <TextView
            android:id="@+id/tv_empty_3d_patients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No patients found"
            android:textColor="#5A6B7D"
            android:textSize="14sp"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
