<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_patient_card"
    android:padding="14dp"
    android:layout_marginBottom="10dp"
    android:elevation="2dp">

    <!-- Top row: description + action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tv_anam_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btn_edit_anam"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_edit"
            android:padding="5dp"
            android:clickable="true"
            android:focusable="true"
            android:alpha="0.7"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/btn_delete_anam"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_delete"
            android:padding="5dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginLeft="2dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Severity chip row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tv_anam_severity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:background="@drawable/bg_status_complete"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_anam_treatment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_light_gray"
        android:textSize="12sp"
        android:layout_marginBottom="3dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_anam_source"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_light_gray"
        android:textSize="12sp"
        android:layout_marginBottom="3dp" />

    <TextView
        android:id="@+id/tv_anam_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#5A7AAF"
        android:textSize="11sp" />
</LinearLayout>
