<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_patient_card"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:layout_marginBottom="10dp"
    android:gravity="center_vertical"
    android:elevation="2dp">

    <!-- Left: Initials Avatar -->
    <FrameLayout
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginRight="14dp">

        <TextView
            android:id="@+id/tv_patient_initials"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_initials_avatar"
            android:text="MS"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center" />

    </FrameLayout>

    <!-- Center: Patient info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_patient_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mike Smith"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_last_exam"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Last Exam: Dec 23, 2025"
            android:textColor="@color/text_light_gray"
            android:textSize="12sp" />

        <!-- Status badge -->
        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Exam Complete"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_status_complete"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />

    </LinearLayout>

    <!-- Right: View button -->
    <TextView
        android:id="@+id/tv_view_patient"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:text="View"
        android:textColor="@color/link_color"
        android:textSize="12sp"
        android:textStyle="bold"
        android:background="@drawable/bg_view_btn"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp" />

</LinearLayout>
