<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <!-- Initials avatar — 48dp circle -->
        <TextView
            android:id="@+id/tv_initials"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_initials_blue"
            android:gravity="center"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#0066CC"
            android:fontFamily="sans-serif-medium"
            tools:text="JR" />

        <!-- Name / type / date -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tv_patient_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#111111"
                android:fontFamily="sans-serif-medium"
                tools:text="jopia, ran" />

            <!-- Tooth icon + case type -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="3dp">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_dental"
                    app:tint="#888888"
                    android:contentDescription="" />

                <TextView
                    android:id="@+id/tv_case_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:textSize="12sp"
                    android:textColor="#888888"
                    tools:text="Dental Restoration" />
            </LinearLayout>

            <!-- Calendar icon + date -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="3dp">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_calendar"
                    app:tint="#888888"
                    android:contentDescription="" />

                <TextView
                    android:id="@+id/tv_case_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:textSize="12sp"
                    android:textColor="#888888"
                    tools:text="Oct 13, 2026" />
            </LinearLayout>
        </LinearLayout>

        <!-- Status pill + chevron -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_status_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:textSize="12sp"
                android:textColor="#E65100"
                android:background="@drawable/bg_pill_no_plan"
                tools:text="No Plan" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_arrow_right"
                app:tint="#BBBBBB"
                android:contentDescription="" />
        </LinearLayout>
    </LinearLayout>

    <!-- Thin divider -->
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="78dp"
        android:background="#EEEEEE" />

</LinearLayout>
