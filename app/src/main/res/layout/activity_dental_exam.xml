<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F1117">

    <!-- ═══ TOP BAR ═══════════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="#1A1D27"
        android:gravity="center_vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp">

        <!-- Back -->
        <LinearLayout
            android:id="@+id/btn_back_dental"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_chip_modern"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginRight="10dp"
            android:clickable="true"
            android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="← Patient" android:textColor="#9CA3AF" android:textSize="11sp" />
        </LinearLayout>

        <!-- Separator -->
        <View android:layout_width="1dp" android:layout_height="20dp"
            android:background="#FFFFFF1A" android:layout_marginRight="10dp" />

        <!-- Title + patient -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="3D Dental Examination"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:id="@+id/tv_dental_patient_name"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#9CA3AF" android:textSize="11sp" />
                <TextView android:id="@+id/tv_dental_session_id"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#6B7280" android:textSize="11sp"
                    android:layout_marginLeft="8dp" android:text="Loading…" />
            </LinearLayout>
        </LinearLayout>

        <!-- Undo -->
        <TextView
            android:id="@+id/btn_undo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↩ Undo"
            android:textColor="#D1D5DB"
            android:textSize="11sp"
            android:background="@drawable/bg_chip_modern"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginRight="6dp"
            android:clickable="true"
            android:focusable="true" />

        <!-- Redo -->
        <TextView
            android:id="@+id/btn_redo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↪ Redo"
            android:textColor="#D1D5DB"
            android:textSize="11sp"
            android:background="@drawable/bg_chip_modern"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginRight="6dp"
            android:clickable="true"
            android:focusable="true" />

        <!-- Separator -->
        <View android:layout_width="1dp" android:layout_height="20dp"
            android:background="#FFFFFF1A" android:layout_marginRight="6dp" />

        <!-- Save -->
        <TextView
            android:id="@+id/btn_save_exam"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💾 Save"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_chip_modern_selected"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- ═══ WEBVIEW (fills remaining space) ══════════════════════════════ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/dental_webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/dental_exam_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="visible" />

    </FrameLayout>

</LinearLayout>
