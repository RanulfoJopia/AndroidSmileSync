<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="24dp"
            android:paddingBottom="80dp">

            <!-- Header with back button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp">

                <ImageView
                    android:id="@+id/btn_back_profile"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_arrow_back"
                    android:contentDescription="Back"
                    android:visibility="gone"
                    app:tint="#1A2B4A" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Profile"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#1A2B4A"
                    android:fontFamily="sans-serif-black" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_notification"
                    android:contentDescription="Notifications"
                    app:tint="#1A2B4A"
                    android:layout_marginEnd="12dp" />

                <com.google.android.material.card.MaterialCardView android:id="@+id/cv_profile_avatar_header" android:layout_width="36dp" android:layout_height="36dp" android:clickable="true" android:focusable="true" app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#E3F2FD">

                    <TextView
                        android:id="@+id/tv_profile_avatar_initials"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="GO"
                        android:textColor="#2196F3"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:gravity="center" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Profile Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        app:cardCornerRadius="30dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#E3F2FD">

                        <TextView
                            android:id="@+id/tv_profile_avatar_large"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="GO"
                            android:textColor="#2196F3"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:gravity="center" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:id="@+id/tv_profile_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Geo Ongbak"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#1A2B4A" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dentist Profile"
                            android:textSize="14sp"
                            android:textColor="#9E9E9E"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Account Security Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_lock"
                            app:tint="#1A2B4A" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Account Security"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#1A2B4A"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_lock"
                            app:tint="#5A6B7D" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="New Password"
                            android:textSize="14sp"
                            android:textColor="#1A2B4A"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/et_new_password"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Enter new password"
                        android:inputType="textPassword"
                        android:textSize="14sp"
                        android:textColor="#1A2B4A"
                        android:background="@drawable/bg_edittext"
                        android:padding="12dp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Leave blank to keep current password"
                        android:textSize="12sp"
                        android:textColor="#9E9E9E"
                        android:layout_marginBottom="12dp"
                        android:paddingStart="24dp" />

                    <Button
                        android:id="@+id/btn_save_changes"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Save Changes"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_button_primary"
                        android:drawableStart="@drawable/ic_save"
                        android:drawablePadding="8dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Subscription & Billing Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_subscription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_crown"
                            app:tint="#1A2B4A" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Subscription &amp; Billing"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#1A2B4A"
                            android:layout_marginStart="8dp" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_arrow_right"
                            app:tint="#9E9E9E" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Manage your SmileSync membership plan, payment method on file, and billing receipts."
                        android:textSize="11sp"
                        android:textColor="#5A6B7D"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginBottom="12dp" />

                    <!-- Plan Card with better layout -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#F5F9FF"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <!-- Plan Name and Badge -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginBottom="12dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="SmileSync Professional Plan"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="#1A2B4A" />

                                <TextView
                                    android:id="@+id/tv_subscription_badge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Free Trial"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:textColor="#4CAF50"
                                    android:background="@drawable/bg_status_green"
                                    android:paddingStart="8dp"
                                    android:paddingEnd="8dp"
                                    android:paddingTop="3dp"
                                    android:paddingBottom="3dp"
                                    android:layout_marginStart="8dp"  android:visibility="gone"/>
                            </LinearLayout>

                            <!-- Price and Subscribe Button -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <!-- Price Section -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="horizontal"
                                    android:gravity="bottom">

                                    <TextView
                                        android:id="@+id/tv_subscription_price"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="$29.00"
                                        android:textSize="28sp"
                                        android:textStyle="bold"
                                        android:textColor="#1A2B4A" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="/month"
                                        android:textSize="12sp"
                                        android:textColor="#5A6B7D"
                                        android:layout_marginStart="4dp"
                                        android:layout_marginBottom="4dp" />
                                </LinearLayout>

                                <!-- Subscribe Now Button -->
                                <Button
                                    android:id="@+id/btn_subscribe_now"
                                    android:layout_width="wrap_content"
                                    android:layout_height="40dp"
                                    android:text="Subscribe Now"
                                    android:textColor="#FFFFFF"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textAllCaps="false"
                                    android:background="@drawable/bg_button_primary"
                                    android:paddingStart="16dp"
                                    android:paddingEnd="16dp"
                                    android:minWidth="0dp" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Trial Expiration and Access Status Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <!-- Trial Expiration -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Trial Expiration"
                                android:textSize="11sp"
                                android:textColor="#9E9E9E"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:id="@+id/tv_trial_expiration"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Dec 9, 2026"
                                android:textSize="13sp"
                                android:textColor="#1A2B4A"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Access Status -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Access Status"
                                android:textSize="11sp"
                                android:textColor="#9E9E9E"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:id="@+id/tv_access_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Full Access (Read/Write)"
                                android:textSize="13sp"
                                android:textColor="#4CAF50"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Payment Method Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_payment_method"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_credit_card"
                            app:tint="#1A2B4A" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Payment Method"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#1A2B4A"
                            android:layout_marginStart="8dp" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_arrow_right"
                            app:tint="#9E9E9E" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_payment_method_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No payment method on file. Add a card for automated subscription renewals."
                        android:textSize="12sp"
                        android:textColor="#5A6B7D"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btn_add_payment_method"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Add Payment Method"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:background="@drawable/bg_btn_outlined_pill"
                        android:drawableStart="@drawable/ic_add"
                        android:drawableTint="#FFFFFF"
                        android:drawablePadding="4dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:minWidth="0dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Cancel Subscription Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_cancel_subscription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFEBEE">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_warning"
                            app:tint="#F44336" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cancel Subscription"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#F44336"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Canceling your subscription will stop recurring payments. Once canceled, you will still have full access until your current billing period ends, but you cannot open, create and update patient records, treatment cases, and dental charts until you renew."
                        android:textSize="12sp"
                        android:textColor="#5A6B7D"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btn_cancel_subscription"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Cancel Subscription"
                        android:textColor="#F44336"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:background="@drawable/bg_button_danger_outlined"
                        android:drawableStart="@drawable/ic_cancel"
                        android:drawableTint="#F44336"
                        android:drawablePadding="4dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:minWidth="0dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Payment History Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_payment_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_receipt"
                        app:tint="#1A2B4A" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Payment History"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#1A2B4A" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="View all billing receipts"
                            android:textSize="12sp"
                            android:textColor="#9E9E9E"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="#9E9E9E" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</FrameLayout>