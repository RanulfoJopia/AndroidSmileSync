<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:padding="20dp">

    <!-- Drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="#3A4A6B"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tv_anam_sheet_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Anamnesis"
        android:textColor="@color/text_white"
        android:textSize="17sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Description -->
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Description *" android:textColor="#5A7AAF" android:textSize="11sp"
        android:layout_marginBottom="4dp" />
    <EditText
        android:id="@+id/et_anam_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:background="@drawable/bg_input_field"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:textColor="@color/text_white"
        android:textColorHint="#5A7AAF"
        android:hint="Description / condition name"
        android:inputType="textMultiLine"
        android:gravity="top"
        android:layout_marginBottom="12dp" />

    <!-- Treatment -->
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Treatment / Medication" android:textColor="#5A7AAF" android:textSize="11sp"
        android:layout_marginBottom="4dp" />
    <EditText
        android:id="@+id/et_anam_treatment"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_input_field"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:textColor="@color/text_white"
        android:textColorHint="#5A7AAF"
        android:hint="e.g. Amoxicillin 500mg"
        android:inputType="text"
        android:layout_marginBottom="12dp" />

    <!-- Severity -->
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Severity" android:textColor="#5A7AAF" android:textSize="11sp"
        android:layout_marginBottom="4dp" />
    <Spinner
        android:id="@+id/sp_anam_severity"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_input_field"
        android:paddingLeft="12dp"
        android:layout_marginBottom="12dp" />

    <!-- Date row -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginBottom="12dp">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:layout_marginRight="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Date Start" android:textColor="#5A7AAF" android:textSize="11sp"
                android:layout_marginBottom="4dp" />
            <TextView
                android:id="@+id/tv_anam_date_start"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_field"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:gravity="center_vertical"
                android:text="Tap to set"
                android:textColor="#5A7AAF"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Date End" android:textColor="#5A7AAF" android:textSize="11sp"
                android:layout_marginBottom="4dp" />
            <TextView
                android:id="@+id/tv_anam_date_end"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_field"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:gravity="center_vertical"
                android:text="Tap to set (optional)"
                android:textColor="#5A7AAF"
                android:textSize="12sp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- Family inherited -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginBottom="20dp">
        <CheckBox
            android:id="@+id/cb_family_inherited"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/accent_blue" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Family Inherited" android:textColor="@color/text_light_gray"
            android:textSize="13sp" android:layout_marginLeft="8dp" />
    </LinearLayout>

    <!-- Buttons -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_anam_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textColor="@color/text_light_gray"
            android:background="@drawable/bg_chip_modern"
            android:stateListAnimator="@null"
            android:layout_marginRight="8dp" />

        <Button
            android:id="@+id/btn_anam_save"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Save"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_primary"
            android:stateListAnimator="@null" />
    </LinearLayout>
</LinearLayout>
