<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="0dp"
    android:paddingEnd="16dp"
    android:paddingTop="0dp"
    android:paddingBottom="8dp">

    <!-- Timeline section (left side) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginEnd="12dp">

        <!-- Step number circle -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#2196F3">

            <TextView
                android:id="@+id/tv_seq_order"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:text="#1" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Connecting line -->
        <View
            android:id="@+id/view_timeline_line"
            android:layout_width="4dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:background="#2196F3" />

        <!-- Bottom dot -->
        <View
            android:id="@+id/view_timeline_dot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_initials_avatar" />
    </LinearLayout>

    <!-- Content card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginTop="0dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#E3F2FD"
        app:strokeColor="#90CAF9"
        app:strokeWidth="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <!-- Icon -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginEnd="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#BBDEFB">

                <ImageView
                    android:id="@+id/iv_seq_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_treatment"
                    android:tint="#1976D2" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Text content -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Title and actions row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_seq_description"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="#1A2B4A"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:lineSpacingExtra="2dp"
                        android:text="Perform diagnostic evaluation" />

                    <!-- Action buttons -->
                    <ImageView
                        android:id="@+id/btn_edit_seq"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_edit"
                        android:padding="6dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:tint="#1976D2"
                        android:visibility="visible" />

                    <ImageView
                        android:id="@+id/btn_delete_seq"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_delete"
                        android:padding="6dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:tint="#EF5350"
                        android:visibility="visible" />
                </LinearLayout>

                <!-- Duration (procedure code) -->
                <LinearLayout
                    android:id="@+id/layout_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_chip_modern"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:visibility="visible">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_time"
                        android:tint="#1976D2"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/tv_seq_code"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#1976D2"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:text="~ 10-15 min" />
                </LinearLayout>

                <!-- Notes/Description -->
                <TextView
                    android:id="@+id/tv_seq_notes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#5A6B7D"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp"
                    android:text="Evaluate the extent of the fracture and administer local anesthesia."
                    android:visibility="visible" />

                <!-- Status badge -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/layout_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#C8E6C9">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_check"
                            android:tint="#2E7D32"
                            android:layout_marginEnd="4dp" />

                        <TextView
                            android:id="@+id/tv_seq_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#2E7D32"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:text="Planned" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
