<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_patient_card"
    android:padding="14dp"
    android:layout_marginBottom="8dp"
    android:gravity="top">

    <!-- Order number badge -->
    <TextView
        android:id="@+id/tv_seq_order"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_initials_avatar"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginRight="12dp" />

    <!-- Content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Description + status row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tv_seq_description"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_seq_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_marginLeft="6dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_seq_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#5A7AAF"
            android:textSize="11sp"
            android:layout_marginBottom="3dp" />

        <TextView
            android:id="@+id/tv_seq_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_light_gray"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Action buttons (hidden in read-only mode) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginLeft="8dp">

        <ImageView
            android:id="@+id/btn_edit_seq"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_edit"
            android:padding="5dp"
            android:clickable="true"
            android:focusable="true"
            android:alpha="0.7"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/btn_delete_seq"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_delete"
            android:padding="5dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginLeft="2dp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
