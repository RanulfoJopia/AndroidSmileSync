<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_app"
    android:fitsSystemWindows="true">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="40dp"
        android:paddingBottom="20dp">

        <!-- Back row -->
        <LinearLayout
            android:id="@+id/btn_back_patient"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView 
                android:layout_width="24dp" 
                android:layout_height="24dp"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Back"
                app:tint="#1A2B4A" />
            <TextView 
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp" 
                android:text="Patients"
                android:textColor="#1A2B4A" 
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_detail_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Patient Name"
            android:textColor="#1A2B4A"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black" />

        <!-- Action buttons row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_case"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="+ Add Case"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textAllCaps="false"
                app:backgroundTint="#2196F3"
                app:cornerRadius="20dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginEnd="8dp"
                app:elevation="0dp"
                android:stateListAnimator="@null" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_dental_exam"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="🦷 3D Exam"
                android:textSize="12sp"
                android:textAllCaps="false"
                app:backgroundTint="#00BCD4"
                app:cornerRadius="20dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginEnd="8dp"
                app:elevation="0dp"
                android:stateListAnimator="@null" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_edit_patient"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:text="✏"
                android:textSize="14sp"
                app:strokeColor="#2196F3"
                app:cornerRadius="20dp"
                android:layout_marginEnd="8dp"
                app:elevation="0dp"
                android:stateListAnimator="@null"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete_patient"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:text="🗑"
                android:textSize="14sp"
                app:strokeColor="#EF5350"
                app:cornerRadius="20dp"
                app:elevation="0dp"
                android:stateListAnimator="@null"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- LOADING -->
    <ProgressBar
        android:id="@+id/patient_detail_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <!-- STAT CARDS ROW -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:layout_marginBottom="16dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#2196F3">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                
                <TextView 
                    android:id="@+id/tv_detail_cases_count"
                    android:layout_width="wrap_content" 
                    android:layout_height="wrap_content"
                    android:text="0" 
                    android:textColor="#FFFFFF" 
                    android:textSize="28sp" 
                    android:textStyle="bold" 
                    android:fontFamily="sans-serif-black" />
                    
                <TextView 
                    android:layout_width="match_parent" 
                    android:layout_height="wrap_content"
                    android:text="Treatment Cases" 
                    android:textColor="#BBDEFB" 
                    android:textSize="12sp" 
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#00BCD4">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                
                <TextView 
                    android:id="@+id/tv_detail_completed_count"
                    android:layout_width="wrap_content" 
                    android:layout_height="wrap_content"
                    android:text="0" 
                    android:textColor="#FFFFFF" 
                    android:textSize="28sp" 
                    android:textStyle="bold" 
                    android:fontFamily="sans-serif-black" />
                    
                <TextView 
                    android:layout_width="match_parent" 
                    android:layout_height="wrap_content"
                    android:text="Completed Cases" 
                    android:textColor="#B2EBF2" 
                    android:textSize="12sp" 
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- TABS -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tab_info"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Info"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:backgroundTint="#2196F3"
                app:cornerRadius="20dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:layout_marginEnd="8dp"
                app:elevation="0dp"
                android:stateListAnimator="@null" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tab_anamnesis"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Anamnesis"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:textColor="#666666"
                app:strokeColor="#DDDDDD"
                app:cornerRadius="20dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:layout_marginEnd="8dp"
                app:elevation="0dp"
                android:stateListAnimator="@null" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tab_documents"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Documents"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:textColor="#666666"
                app:strokeColor="#DDDDDD"
                app:cornerRadius="20dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:layout_marginEnd="8dp"
                app:elevation="0dp"
                android:stateListAnimator="@null" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tab_cases"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Cases"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:textColor="#666666"
                app:strokeColor="#DDDDDD"
                app:cornerRadius="20dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                app:elevation="0dp"
                android:stateListAnimator="@null" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- TAB CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <!-- INFO PANEL -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/panel_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout 
                        android:layout_width="match_parent" 
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" 
                        android:layout_marginBottom="16dp">
                        
                        <LinearLayout 
                            android:layout_width="0dp" 
                            android:layout_height="wrap_content"
                            android:layout_weight="1" 
                            android:orientation="vertical">
                            
                            <TextView 
                                android:text="Birthdate" 
                                android:textColor="#666666" 
                                android:textSize="11sp"
                                android:textStyle="bold" 
                                android:layout_width="wrap_content" 
                                android:layout_height="wrap_content" 
                                android:layout_marginBottom="4dp" />
                                
                            <TextView 
                                android:id="@+id/tv_detail_birthdate" 
                                android:textColor="#1A2B4A"
                                android:textSize="15sp" 
                                android:textStyle="bold"
                                android:layout_width="wrap_content" 
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                        
                        <LinearLayout 
                            android:layout_width="0dp" 
                            android:layout_height="wrap_content"
                            android:layout_weight="1" 
                            android:orientation="vertical">
                            
                            <TextView 
                                android:text="Age" 
                                android:textColor="#666666" 
                                android:textSize="11sp"
                                android:textStyle="bold" 
                                android:layout_width="wrap_content" 
                                android:layout_height="wrap_content" 
                                android:layout_marginBottom="4dp" />
                                
                            <TextView 
                                android:id="@+id/tv_detail_age" 
                                android:textColor="#1A2B4A"
                                android:textSize="15sp" 
                                android:textStyle="bold"
                                android:layout_width="wrap_content" 
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                        
                        <LinearLayout 
                            android:layout_width="0dp" 
                            android:layout_height="wrap_content"
                            android:layout_weight="1" 
                            android:orientation="vertical">
                            
                            <TextView 
                                android:text="Sex" 
                                android:textColor="#666666" 
                                android:textSize="11sp"
                                android:textStyle="bold" 
                                android:layout_width="wrap_content" 
                                android:layout_height="wrap_content" 
                                android:layout_marginBottom="4dp" />
                                
                            <TextView 
                                android:id="@+id/tv_detail_sex" 
                                android:textColor="#1A2B4A"
                                android:textSize="15sp" 
                                android:textStyle="bold"
                                android:layout_width="wrap_content" 
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView 
                        android:text="Address" 
                        android:textColor="#666666" 
                        android:textSize="11sp"
                        android:textStyle="bold" 
                        android:layout_width="wrap_content" 
                        android:layout_height="wrap_content" 
                        android:layout_marginBottom="4dp" />
                        
                    <TextView 
                        android:id="@+id/tv_detail_address" 
                        android:textColor="#1A2B4A"
                        android:textSize="15sp" 
                        android:layout_marginBottom="16dp"
                        android:layout_width="wrap_content" 
                        android:layout_height="wrap_content" />

                    <TextView 
                        android:text="Latest Treatment Case" 
                        android:textColor="#666666" 
                        android:textSize="11sp"
                        android:textStyle="bold" 
                        android:layout_width="wrap_content" 
                        android:layout_height="wrap_content" 
                        android:layout_marginBottom="4dp" />
                        
                    <TextView 
                        android:id="@+id/tv_detail_latest_case" 
                        android:textColor="#1A2B4A"
                        android:textSize="15sp" 
                        android:layout_width="match_parent" 
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ANAMNESIS PANEL -->
            <LinearLayout
                android:id="@+id/panel_anamnesis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- FAB row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end"
                    android:layout_marginBottom="12dp">
                    
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/fab_add_anamnesis"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="+ Add Anamnesis"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textAllCaps="false"
                        app:backgroundTint="#2196F3"
                        app:cornerRadius="8dp"
                        app:elevation="0dp"
                        android:stateListAnimator="@null"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_no_anamnesis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No anamnesis records yet"
                    android:textColor="#999999"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:padding="32dp"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_anamnesis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>

            <!-- DOCUMENTS PANEL -->
            <LinearLayout
                android:id="@+id/panel_documents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- FAB row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end"
                    android:layout_marginBottom="12dp">
                    
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/fab_upload_doc"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="↑ Upload Document"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textAllCaps="false"
                        app:backgroundTint="#00BCD4"
                        app:cornerRadius="8dp"
                        app:elevation="0dp"
                        android:stateListAnimator="@null"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_no_documents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No documents uploaded yet"
                    android:textColor="#999999"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:padding="32dp"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_documents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>

            <!-- CASES PANEL -->
            <LinearLayout
                android:id="@+id/panel_cases"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_cases"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
