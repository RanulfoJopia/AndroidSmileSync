<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_hero"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="20dp">

        <!-- Back row -->
        <LinearLayout
            android:id="@+id/btn_back_patient"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                android:src="@drawable/ic_arrow_right" android:rotation="180" android:alpha="0.7" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginLeft="6dp" android:text="Patients"
                android:textColor="@color/text_light_gray" android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_detail_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Patient Name"
            android:textColor="@color/text_white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Action buttons row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp">

            <TextView
                android:id="@+id/btn_add_case"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ Add Case"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_chip_modern_selected"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:layout_marginRight="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_dental_exam"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🦷 3D Exam"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_stat_card_teal"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:layout_marginRight="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_edit_patient"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✏ Edit"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:background="@drawable/bg_chip_modern"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:layout_marginRight="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_delete_patient"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🗑"
                android:textColor="#EF9A9A"
                android:textSize="14sp"
                android:background="@drawable/bg_chip_modern"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- LOADING -->
    <ProgressBar
        android:id="@+id/patient_detail_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <!-- STAT CARDS ROW -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="16dp"
        android:layout_marginBottom="2dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginRight="8dp"
            android:orientation="vertical"
            android:background="@drawable/bg_stat_card_blue"
            android:padding="12dp"
            android:elevation="4dp">
            <TextView android:id="@+id/tv_detail_cases_count"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Treatment Cases" android:textColor="#BBDEFB" android:textSize="11sp" android:maxLines="2" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:orientation="vertical"
            android:background="@drawable/bg_stat_card_teal"
            android:padding="12dp"
            android:elevation="4dp">
            <TextView android:id="@+id/tv_detail_completed_count"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Completed Cases" android:textColor="#B2EBF2" android:textSize="11sp" android:maxLines="2" />
        </LinearLayout>
    </LinearLayout>

    <!-- TABS — scrollable so all 4 fit on small screens -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tab_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Info"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/accent_blue"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginRight="6dp"
                android:background="@drawable/bg_chip_modern_selected" />

            <TextView
                android:id="@+id/tab_anamnesis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Anamnesis"
                android:textSize="13sp"
                android:textColor="@color/text_light_gray"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginRight="6dp"
                android:background="@drawable/bg_chip_modern" />

            <TextView
                android:id="@+id/tab_documents"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Documents"
                android:textSize="13sp"
                android:textColor="@color/text_light_gray"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginRight="6dp"
                android:background="@drawable/bg_chip_modern" />

            <TextView
                android:id="@+id/tab_cases"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cases"
                android:textSize="13sp"
                android:textColor="@color/text_light_gray"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="@drawable/bg_chip_modern" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- TAB CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- INFO PANEL -->
            <LinearLayout
                android:id="@+id/panel_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_glass"
                android:padding="16dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="10dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:text="Birthdate" android:textColor="#5A7AAF" android:textSize="10sp"
                            android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        <TextView android:id="@+id/tv_detail_birthdate" android:textColor="@color/text_white"
                            android:textSize="14sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:text="Age" android:textColor="#5A7AAF" android:textSize="10sp"
                            android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        <TextView android:id="@+id/tv_detail_age" android:textColor="@color/text_white"
                            android:textSize="14sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:text="Sex" android:textColor="#5A7AAF" android:textSize="10sp"
                            android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        <TextView android:id="@+id/tv_detail_sex" android:textColor="@color/text_white"
                            android:textSize="14sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>

                <TextView android:text="Address" android:textColor="#5A7AAF" android:textSize="10sp"
                    android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tv_detail_address" android:textColor="@color/text_white"
                    android:textSize="14sp" android:layout_marginBottom="12dp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />

                <TextView android:text="Latest Treatment Case" android:textColor="#5A7AAF" android:textSize="10sp"
                    android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tv_detail_latest_case" android:textColor="@color/text_white"
                    android:textSize="14sp" android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- ANAMNESIS PANEL -->
            <LinearLayout
                android:id="@+id/panel_anamnesis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- FAB row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end"
                    android:layout_marginBottom="10dp">
                    <TextView
                        android:id="@+id/fab_add_anamnesis"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+ Add Anamnesis"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_chip_modern_selected"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_no_anamnesis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No anamnesis records yet"
                    android:textColor="@color/text_light_gray"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:padding="24dp"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_anamnesis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>

            <!-- DOCUMENTS PANEL -->
            <LinearLayout
                android:id="@+id/panel_documents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- FAB row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end"
                    android:layout_marginBottom="10dp">
                    <TextView
                        android:id="@+id/fab_upload_doc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="↑ Upload Document"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_stat_card_teal"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_no_documents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No documents uploaded yet"
                    android:textColor="@color/text_light_gray"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:padding="24dp"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_documents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>

            <!-- CASES PANEL -->
            <LinearLayout
                android:id="@+id/panel_cases"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_cases"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
