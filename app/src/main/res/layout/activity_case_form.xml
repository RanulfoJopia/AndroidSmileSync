<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/apk/res/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_app"
    android:fitsSystemWindows="true">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="40dp"
        android:paddingBottom="20dp">

        <ImageView
            android:id="@+id/btn_back_case_form"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp"
            app:tint="#1A2B4A" />

        <TextView
            android:id="@+id/tv_case_form_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Add Treatment Case"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#1A2B4A"
            android:fontFamily="sans-serif-black"
            android:layout_marginStart="12dp"
            />
    </LinearLayout>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/case_form_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone"
        android:layout_marginBottom="12dp" />

    <!-- Form Content - Scrollable -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <!-- Patient Selection -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Patient *"
                    android:textSize="12sp"
                    android:textColor="#1A2B4A"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <Spinner
                        android:id="@+id/sp_patient"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:spinnerMode="dropdown"
                        android:background="@android:color/transparent" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Case Type Selection -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Case Type *"
                    android:textSize="12sp"
                    android:textColor="#1A2B4A"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <Spinner
                        android:id="@+id/sp_case_type"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:spinnerMode="dropdown"
                        android:background="@android:color/transparent" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Case Title -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Case Title *"
                    android:textSize="12sp"
                    android:textColor="#1A2B4A"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <EditText
                        android:id="@+id/et_case_title"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:hint="e.g. Full Orthodontic Treatment"
                        android:textColor="#1A2B4A"
                        android:textColorHint="#9E9E9E"
                        android:textSize="15sp"
                        android:background="@android:color/transparent"
                        android:inputType="text"
                        android:maxLines="1" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Chief Complaint -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chief Complaint"
                    android:textSize="12sp"
                    android:textColor="#1A2B4A"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <EditText
                        android:id="@+id/et_chief_complaint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="100dp"
                        android:padding="16dp"
                        android:hint="Patient's main concern..."
                        android:textColor="#1A2B4A"
                        android:textColorHint="#9E9E9E"
                        android:textSize="15sp"
                        android:background="@android:color/transparent"
                        android:gravity="top|start"
                        android:inputType="textMultiLine|textCapSentences" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Dentist Diagnosis -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dentist Diagnosis"
                    android:textSize="12sp"
                    android:textColor="#1A2B4A"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <EditText
                        android:id="@+id/et_dentist_diagnosis"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="100dp"
                        android:padding="16dp"
                        android:hint="Your clinical diagnosis..."
                        android:textColor="#1A2B4A"
                        android:textColorHint="#9E9E9E"
                        android:textSize="15sp"
                        android:background="@android:color/transparent"
                        android:gravity="top|start"
                        android:inputType="textMultiLine|textCapSentences" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Clinical Findings -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clinical Findings"
                    android:textSize="12sp"
                    android:textColor="#1A2B4A"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <EditText
                        android:id="@+id/et_clinical_findings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="100dp"
                        android:padding="16dp"
                        android:hint="Observed findings..."
                        android:textColor="#1A2B4A"
                        android:textColorHint="#9E9E9E"
                        android:textSize="15sp"
                        android:background="@android:color/transparent"
                        android:gravity="top|start"
                        android:inputType="textMultiLine|textCapSentences" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Vital Signs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vital Signs"
                    android:textSize="12sp"
                    android:textColor="#1A2B4A"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <EditText
                        android:id="@+id/et_vital_signs"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:hint="BP, HR, temp..."
                        android:textColor="#1A2B4A"
                        android:textColorHint="#9E9E9E"
                        android:textSize="15sp"
                        android:background="@android:color/transparent"
                        android:inputType="text"
                        android:maxLines="1" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Description -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Description"
                    android:textSize="12sp"
                    android:textColor="#1A2B4A"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <EditText
                        android:id="@+id/et_case_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="100dp"
                        android:padding="16dp"
                        android:hint="Case overview..."
                        android:textColor="#1A2B4A"
                        android:textColorHint="#9E9E9E"
                        android:textSize="15sp"
                        android:background="@android:color/transparent"
                        android:gravity="top|start"
                        android:inputType="textMultiLine|textCapSentences" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Case Notes -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Case Notes"
                    android:textSize="12sp"
                    android:textColor="#1A2B4A"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <EditText
                        android:id="@+id/et_case_notes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="100dp"
                        android:padding="16dp"
                        android:hint="Additional notes..."
                        android:textColor="#1A2B4A"
                        android:textColorHint="#9E9E9E"
                        android:textSize="15sp"
                        android:background="@android:color/transparent"
                        android:gravity="top|start"
                        android:inputType="textMultiLine|textCapSentences" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Save Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_case"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Save Case"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="#2196F3"
                app:cornerRadius="8dp"
                android:stateListAnimator="@null"
                app:elevation="0dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
