<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ═══════════════════════════════════════════════════════════════════
         SMILESYNC TYPOGRAPHY SYSTEM
         Material Design 3 typography scale with professional hierarchy
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- ═══ BASE TEXT APPEARANCE ═══ -->
    <style name="TextAppearance.SmileSync" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_primary_dark</item>
    </style>

    <!-- ═══ DISPLAY STYLES (Large, expressive text) ═══ -->
    <style name="TextAppearance.SmileSync.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:textSize">@dimen/text_display_large</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.SmileSync.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:textSize">@dimen/text_display_medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.SmileSync.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">@dimen/text_display_small</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- ═══ HEADLINE STYLES (High-emphasis text) ═══ -->
    <style name="TextAppearance.SmileSync.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">@dimen/text_headline_large</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.SmileSync.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">@dimen/text_headline_medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.SmileSync.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">@dimen/text_headline_small</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- ═══ TITLE STYLES (Medium-emphasis text) ═══ -->
    <style name="TextAppearance.SmileSync.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_title_large</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.SmileSync.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_title_medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.SmileSync.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">@dimen/text_title_small</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- ═══ BODY STYLES (Regular text) ═══ -->
    <style name="TextAppearance.SmileSync.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_body_large</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="TextAppearance.SmileSync.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body_medium</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="TextAppearance.SmileSync.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_body_small</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!-- ═══ LABEL STYLES (UI elements) ═══ -->
    <style name="TextAppearance.SmileSync.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">@dimen/text_label_large</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextAppearance.SmileSync.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">@dimen/text_label_medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextAppearance.SmileSync.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">@dimen/text_label_small</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- ═══ SPECIALIZED TEXT STYLES ═══ -->
    
    <!-- Page Titles -->
    <style name="TextAppearance.SmileSync.PageTitle">
        <item name="android:textSize">@dimen/text_headline_medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary_dark</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- Section Headers -->
    <style name="TextAppearance.SmileSync.SectionHeader">
        <item name="android:textSize">@dimen/text_title_medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary_dark</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- Card Titles -->
    <style name="TextAppearance.SmileSync.CardTitle">
        <item name="android:textSize">@dimen/text_title_medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary_dark</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- Card Subtitle -->
    <style name="TextAppearance.SmileSync.CardSubtitle">
        <item name="android:textSize">@dimen/text_body_medium</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_secondary_dark</item>
    </style>

    <!-- Stat Numbers -->
    <style name="TextAppearance.SmileSync.StatNumber">
        <item name="android:textSize">32sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- Stat Labels -->
    <style name="TextAppearance.SmileSync.StatLabel">
        <item name="android:textSize">@dimen/text_body_small</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:alpha">0.8</item>
    </style>

    <!-- Button Text -->
    <style name="TextAppearance.SmileSync.Button">
        <item name="android:textSize">@dimen/text_label_large</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Input Labels -->
    <style name="TextAppearance.SmileSync.InputLabel">
        <item name="android:textSize">@dimen/text_body_small</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_secondary_dark</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!-- Input Text -->
    <style name="TextAppearance.SmileSync.InputText">
        <item name="android:textSize">@dimen/text_body_large</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_primary_dark</item>
    </style>

    <!-- Helper Text / Captions -->
    <style name="TextAppearance.SmileSync.Caption">
        <item name="android:textSize">@dimen/text_body_small</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_tertiary_dark</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!-- Error Text -->
    <style name="TextAppearance.SmileSync.Error">
        <item name="android:textSize">@dimen/text_body_small</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/error</item>
    </style>

    <!-- Badge Text -->
    <style name="TextAppearance.SmileSync.Badge">
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Tab Text -->
    <style name="TextAppearance.SmileSync.Tab">
        <item name="android:textSize">@dimen/text_label_large</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- List Item Primary -->
    <style name="TextAppearance.SmileSync.ListPrimary">
        <item name="android:textSize">@dimen/text_body_large</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_primary_dark</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- List Item Secondary -->
    <style name="TextAppearance.SmileSync.ListSecondary">
        <item name="android:textSize">@dimen/text_body_medium</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_secondary_dark</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- Overline (e.g., "PATIENTS", "CASES") -->
    <style name="TextAppearance.SmileSync.Overline">
        <item name="android:textSize">@dimen/text_label_small</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_tertiary_dark</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:textAllCaps">true</item>
    </style>
</resources>
