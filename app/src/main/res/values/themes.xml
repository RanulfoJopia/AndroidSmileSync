<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Base.Theme.SmileSync" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryVariant">@color/accent_blue_light</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">@color/bg_dark_navy</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/bg_dark_navy</item>
        <item name="android:navigationBarColor">@color/bg_dark_navy</item>
    </style>

    <style name="Theme.SmileSync" parent="Base.Theme.SmileSync" />
    
    <!-- Light theme variant -->
    <style name="Theme.SmileSync.Light" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryVariant">@color/accent_blue_light</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">@color/background_light</item>
        <item name="android:statusBarColor">@color/accent_blue</item>
        <item name="android:navigationBarColor">@color/bg_dark_navy</item>
    </style>
    
    <!-- Dark theme variant -->
    <style name="Theme.SmileSync.Dark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryVariant">@color/accent_blue_light</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">@color/surface_dark</item>
        <item name="android:statusBarColor">@color/surface_dark</item>
        <item name="android:navigationBarColor">@color/surface_dark</item>
    </style>
</resources>