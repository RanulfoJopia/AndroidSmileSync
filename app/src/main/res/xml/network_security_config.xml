<?xml version="1.0" encoding="utf-8"?>
<!--
    Allows cleartext (plain HTTP) traffic to development and production servers.
    IMPORTANT: Use HTTPS in production for security.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Production server -->
        <domain includeSubdomains="true">35.212.220.242</domain>
        
        <!-- Development servers -->
        <!-- Android emulator → host machine -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- Physical device on LAN -->
        <domain includeSubdomains="false">192.168.1.1</domain>
        <!-- localhost -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
