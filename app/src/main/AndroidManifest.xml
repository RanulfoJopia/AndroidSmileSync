<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".SmileSyncApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmileSync"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- ═══ AUTH ═══════════════════════════════════════════════════════ -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.ForgotPasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- ═══ MAIN SHELL ═══════════════════════════════════════════════ -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false" />

        <!-- ═══ PATIENT SCREENS ══════════════════════════════════════════ -->
        <activity
            android:name=".activities.PatientDetailActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.PatientFormActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- ═══ TREATMENT CASE SCREENS ══════════════════════════════════ -->
        <activity
            android:name=".activities.CaseSingleActivity"
            android:exported="false" />

        <activity
            android:name=".activities.CaseFormActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- ═══ PROFILE ═══════════════════════════════════════════════ -->
        <activity
            android:name=".activities.ProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- ═══ 3D DENTAL EXAM ══════════════════════════════════════════ -->
        <activity
            android:name=".activities.DentalExamActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

    </application>

</manifest>
